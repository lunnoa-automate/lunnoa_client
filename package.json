{
  "name": "@lunnoa/client",
  "version": "0.0.1",
  "description": "TypeScript SDK for building applications on top of Lunnoa Automate — typed client for the Public API (agents, workflows, executions, entities, knowledge, queues), SSE agent chat streaming, and deployment-specific codegen",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "lunnoa-client": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",

    "codegen:spec": "openapi-typescript spec/openapi.public.json -o src/generated/schema.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:codegen-sample": "node --experimental-strip-types scripts/check-codegen-sample.ts && tsc --noEmit -p scripts/tsconfig.codegen-sample.json",
    "prepublishOnly": "pnpm run build",
    "release": "semantic-release"
  },
  "dependencies": {
    "ai": "^6.0.199"
  },
  "peerDependencies": {
    "@ai-sdk/react": "^3.0.0 || ^4.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@ai-sdk/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/react": "^3.0.230",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "semantic-release": "^25.0.3",
    "tsup": "^8.3.0",
    "typescript": "~5.7.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lunnoa-automate/lunnoa_client.git"
  },
  "homepage": "https://github.com/lunnoa-automate/lunnoa_client",
  "bugs": {
    "url": "https://github.com/lunnoa-automate/lunnoa_client/issues"
  },
  "keywords": [
    "lunnoa",
    "lunnoa-automate",
    "lunnoa-client",
    "sdk",
    "api-client",
    "automation",
    "workflow",
    "agents",
    "ai-agents",
    "openapi",
    "typescript",
    "sse",
    "streaming"
  ],
  "license": "Apache-2.0 with Commons Clause",
  "pnpm": {
    "overrides": {
      "esbuild@<0.28.1": ">=0.28.1"
    }
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  }
}
